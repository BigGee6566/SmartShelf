<?xml version="1.0" encoding="utf-8"?>
<!--
  SmartShelf - Supermarket Management System
  Deployment note: to host on SmarterASP.NET (or any IIS box), the only value that
  must change is the SmartShelfDb connection string below.
  -->
<configuration>
  <configSections>
    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>

  <connectionStrings>
    <!-- Local SQL Express. For shared hosting (SmarterASP.NET), change Data Source and swap
         Integrated Security for User ID/Password - nothing else in the app needs to change. -->
    <add name="SmartShelfDb"
         connectionString="Data Source=LAPTOP-B5HU784A\SQLEXPRESS;Initial Catalog=SmartShelf;Integrated Security=True;Encrypt=False"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <!-- Classic validator script instead of the unobtrusive/jQuery variant. The app ships no
         external scripts, and a strict host with no CDN access must still validate. -->
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
    <!-- Default VAT rate applied to new products (South Africa, 15%). -->
    <add key="DefaultVatRate" value="0.15" />
    <!-- Cash-up variance (in Rand, absolute) above which a manager must review the shift. -->
    <add key="CashUpVarianceThreshold" value="0" />
    <!-- Standing till float placed in the drawer at the start of a shift. It is added to the
         expected cash at cash-up, so it must match what the store actually puts in the till. -->
    <add key="DefaultOpeningFloat" value="500.00" />
    <!-- Expiry report horizon: batches expiring within this many days are flagged. -->
    <add key="ExpiryWarningDays" value="14" />
    <!-- Maximum accepted product image upload size in bytes (2 MB). -->
    <add key="MaxImageUploadBytes" value="2097152" />
  </appSettings>

  <system.web>
    <compilation debug="true" targetFramework="4.8.1" />
    <!-- maxRequestLength is in KB; sized for product image uploads plus form overhead. -->
    <httpRuntime targetFramework="4.8.1" maxRequestLength="4096" requestValidationMode="4.5" />
    <authentication mode="Forms">
      <forms loginUrl="~/Login.aspx" defaultUrl="~/Default.aspx" timeout="60" slidingExpiration="true"
             cookieless="UseCookies" protection="All" name=".SMARTSHELFAUTH" />
    </authentication>
    <!-- Everything under the site root requires a signed-in user; the <location> blocks
         below re-open the public pages and static assets to anonymous visitors. -->
    <authorization>
      <deny users="?" />
    </authorization>
    <sessionState mode="InProc" timeout="60" />
    <!-- Pinned so money and dates render identically on every machine this is deployed to.
         en-GB gives "12,480.50" and dd/MM/yyyy, matching how the store's till slips read.
         Amounts posted from <input type="number"> are always invariant, so the service and page
         code parse those with InvariantCulture regardless of this setting. -->
    <globalization culture="en-GB" uiCulture="en-GB" />
    <customErrors mode="RemoteOnly" defaultRedirect="~/Error.aspx">
      <error statusCode="403" redirect="~/AccessDenied.aspx" />
      <error statusCode="404" redirect="~/Error.aspx" />
    </customErrors>
    <pages enableViewStateMac="true" viewStateEncryptionMode="Auto" />
  </system.web>

  <!-- Public (anonymous) areas -->
  <location path="Default.aspx">
    <system.web><authorization><allow users="*" /></authorization></system.web>
  </location>
  <location path="Login.aspx">
    <system.web><authorization><allow users="*" /></authorization></system.web>
  </location>
  <location path="Error.aspx">
    <system.web><authorization><allow users="*" /></authorization></system.web>
  </location>
  <location path="AccessDenied.aspx">
    <system.web><authorization><allow users="*" /></authorization></system.web>
  </location>
  <location path="Styles">
    <system.web><authorization><allow users="*" /></authorization></system.web>
  </location>
  <location path="Scripts">
    <system.web><authorization><allow users="*" /></authorization></system.web>
  </location>
  <location path="Images">
    <system.web><authorization><allow users="*" /></authorization></system.web>
  </location>

  <!-- Role-restricted areas. Config-level gating is the first line of defence only;
       every page in these folders also inherits a server-side role check from
       SecurePageBase, so a mis-edited config cannot silently expose a screen. -->
  <location path="Cashier">
    <system.web>
      <authorization>
        <allow roles="Cashier,Manager" />
        <deny users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Manager">
    <system.web>
      <authorization>
        <allow roles="Manager" />
        <deny users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Supplier">
    <system.web>
      <authorization>
        <allow roles="Supplier" />
        <deny users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Admin">
    <system.web>
      <authorization>
        <allow roles="Admin" />
        <deny users="*" />
      </authorization>
    </system.web>
  </location>

  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="Default.aspx" />
      </files>
    </defaultDocument>
    <httpErrors errorMode="DetailedLocalOnly" />
  </system.webServer>

  <system.codedom>
    <compilers>
      <compiler language="c#;cs;csharp" extension=".cs" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.CSharpCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=2.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:default /nowarn:1659;1699;1701" />
      <compiler language="vb;vbs;visualbasic;vbscript" extension=".vb" type="Microsoft.CodeDom.Providers.DotNetCompilerPlatform.VBCodeProvider, Microsoft.CodeDom.Providers.DotNetCompilerPlatform, Version=2.0.1.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" warningLevel="4" compilerOptions="/langversion:default /nowarn:41008 /define:_MYTYPE=\&quot;Web\&quot; /optionInfer+" />
    </compilers>
  </system.codedom>

  <entityFramework>
    <!-- No initializer is registered in code (see Global.asax): the database is created
         and seeded by App_Data\SmartShelf_Schema.sql, which is the source of truth. -->
    <defaultConnectionFactory type="System.Data.Entity.Infrastructure.SqlConnectionFactory, EntityFramework" />
    <providers>
      <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
  </entityFramework>
</configuration>
